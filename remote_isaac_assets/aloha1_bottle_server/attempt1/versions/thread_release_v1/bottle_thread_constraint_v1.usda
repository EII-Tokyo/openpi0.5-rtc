#usda 1.0
(
    customLayerData = {
        string classification = "ISAAC_SIM_5_1_RUNTIME_VALIDATED_THREADED_BASELINE"
        string initialThreadState = "THREADED"
        string parameterStatus = "TEMPORARY_UNCALIBRATED"
        string version = "thread_release_v1"
    }
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "ALOHA1RemoteBottleSession"
    {
        over "Bottle500" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            bool physics:kinematicEnabled = 0
        }

        over "BottleCap" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            bool physics:kinematicEnabled = 0
        }

        def Xform "BottleThreadSlider" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            customData = {
                string calibrationStatus = "TEMPORARY_UNCALIBRATED"
                string role = "INVISIBLE_THREAD_CARRIAGE"
            }
        )
        {
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.001
            double3 xformOp:translate = (0.085, 0, 0.034)
            quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Scope "BottleThreadJoints" (
            customData = {
                string threadState = "THREADED"
            }
        )
        {
            def PhysicsPrismaticJoint "ThreadPrismatic"
            {
                bool physics:jointEnabled = 1
                uniform token physics:axis = "Z"
                rel physics:body0 = </World/ALOHA1RemoteBottleSession/Bottle500>
                rel physics:body1 = </World/ALOHA1RemoteBottleSession/BottleThreadSlider>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, 0, 0.188)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0
            }

            def PhysicsRevoluteJoint "ThreadRevolute"
            {
                bool physics:jointEnabled = 1
                uniform token physics:axis = "Z"
                rel physics:body0 = </World/ALOHA1RemoteBottleSession/BottleThreadSlider>
                rel physics:body1 = </World/ALOHA1RemoteBottleSession/BottleCap>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0
            }

            def PhysxPhysicsRackAndPinionJoint "RightHandThreadCoupling" (
                customData = {
                    double axialTravelM = 0.012
                    string calibrationStatus = "TEMPORARY_UNCALIBRATED"
                    double pitchMPerTurn = 0.003
                    string positiveRemovalRotation = "CAP_POSITIVE_LOCAL_Z"
                    string threadHandedness = "RIGHT_HAND"
                    string threadState = "THREADED"
                }
            )
            {
                bool physics:jointEnabled = 0
                rel physics:body0 = </World/ALOHA1RemoteBottleSession/BottleCap>
                rel physics:body1 = </World/ALOHA1RemoteBottleSession/BottleThreadSlider>
                bool physics:collisionEnabled = 0
                rel physics:hinge = </World/ALOHA1RemoteBottleSession/BottleThreadJoints/ThreadRevolute>
                rel physics:prismatic = </World/ALOHA1RemoteBottleSession/BottleThreadJoints/ThreadPrismatic>
                float physics:ratio = -120000
            }
        }
    }
}
