#usda 1.0
(
    customLayerData = {
        string classification = "SEGMENTED_AXIAL_COMPLIANT_REPLACEMENT_PAD_TEST_V1"
        string contactModel = "RIGID_SEGMENTS_WITH_COMPLIANT_PHYSICS_MATERIAL"
        int segmentsPerFinger = 3
        string placementBasis = "MEASURED_SUCCESSFUL_GRASP_CONTACTS_IN_FINGER_LOCAL_FRAMES"
    }
    metersPerUnit = 1
    upAxis = "Z"
)

# The successful rigid-CAD grasp contacted the left and right fingers near
# local x=77 mm, but their Bottle-axial contact centroids differed by about
# 19.7 mm. These mirrored axial segments sit on that measured contact band.
# In this experimental layer only, the two supplier finger meshes are disabled
# and the pad faces are recessed by 3 mm from their measured contact planes.
# This restores open-gripper clearance and makes all Bottle/finger contact come
# from the symmetric pads. The visible supplier meshes are unchanged.

over "World"
{
    over "follower_left"
    {
        over "vx300s_left"
        {
            over "follower_left_left_finger_link"
            {
                over "collisions"
                {
                    over "diagnostic_supplier_cad_left_finger"
                    {
                        over "mesh"
                        {
                            bool physics:collisionEnabled = 0
                        }
                    }
                }

                def Xform "segmented_conformal_pad_v1"
                {
                    def Cube "axial_neg" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, -0.01466, -0.016)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                    def Cube "axial_mid" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, -0.01466, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                    def Cube "axial_pos" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, -0.01466, 0.016)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                }
            }

            over "follower_left_right_finger_link"
            {
                over "collisions"
                {
                    over "diagnostic_supplier_cad_right_finger"
                    {
                        over "mesh"
                        {
                            bool physics:collisionEnabled = 0
                        }
                    }
                }

                def Xform "segmented_conformal_pad_v1"
                {
                    def Cube "axial_neg" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, 0.01362, -0.016)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                    def Cube "axial_mid" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, 0.01362, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                    def Cube "axial_pos" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        color3f[] primvars:displayColor = [(0.08, 0.18, 0.28)]
                        bool physics:collisionEnabled = 1
                        rel material:binding:physics = </World/BottleTaskPhysicsMaterials/GripperPad_TEMP>
                        double size = 1
                        double3 xformOp:scale = (0.008, 0.003, 0.014)
                        double3 xformOp:translate = (0.075, 0.01362, 0.016)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }
                }
            }
        }
    }
}
