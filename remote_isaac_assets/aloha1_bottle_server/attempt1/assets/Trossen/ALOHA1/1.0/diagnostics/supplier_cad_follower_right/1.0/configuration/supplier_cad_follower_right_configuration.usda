        over "follower_right_left_finger_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            string isaac:nameOverride

            over "visuals" (
                instanceable = false
            )
            {
                over "gripper_finger" (
                    active = false
                )
                {
                }
            }

            over "collisions" (
                instanceable = false
            )
            {
                over "gripper_finger" (
                    active = false
                )
                {
                }
            }
        }

        over "follower_right_right_finger_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
