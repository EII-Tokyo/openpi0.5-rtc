#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def "PhysicsMaterials"
    {
        def Material "BottleSurface_TEMP" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string calibrationStatus = "TEMPORARY_UNCALIBRATED"
            }
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.65
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "CapSurface_TEMP" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string calibrationStatus = "TEMPORARY_UNCALIBRATED"
            }
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "TableSurface_TEMP" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string calibrationStatus = "TEMPORARY_UNCALIBRATED"
            }
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "GripperPad_TEMP" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string calibrationStatus = "TEMPORARY_UNCALIBRATED"
            }
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        custom rel material:binding:physics = </World/PhysicsMaterials/TableSurface_TEMP>
        double size = 1
        float3 xformOp:scale = (0.6, 0.6, 0.02)
        double3 xformOp:translate = (0, 0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

