    def "Looks"
    {
        def Material "MAT_Cap_DeepBlue_Plastic"
        {
            token outputs:surface.connect = </BottleCap/Looks/MAT_Cap_DeepBlue_Plastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.35
                float inputs:clearcoatRoughness = 0.18
                color3f inputs:diffuseColor = (0.025, 0.09, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "MAT_Cap_Rib_Highlight"
        {
            token outputs:surface.connect = </BottleCap/Looks/MAT_Cap_Rib_Highlight/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.2
                color3f inputs:diffuseColor = (0.07, 0.32, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "MAT_Cap_Top_Accent"
        {
            token outputs:surface.connect = </BottleCap/Looks/MAT_Cap_Top_Accent/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.45
                color3f inputs:diffuseColor = (0.1, 0.42, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "MAT_Cap_Physics_TEMP" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "min"
        }
    }

