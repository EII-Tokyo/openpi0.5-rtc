#usda 1.0

over "vx300s_right" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string[] isaac:changelog
    string isaac:description
    token isaac:license
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </vx300s_right/joints/ee_arm>,
        </vx300s_right/joints/ee_bar>,
        </vx300s_right/joints/ee_gripper>,
        </vx300s_right/joints/elbow>,
        </vx300s_right/joints/forearm_roll>,
        </vx300s_right/joints/gripper>,
        </vx300s_right/joints/gripper_bar>,
        </vx300s_right/joints/left_finger>,
        </vx300s_right/joints/right_finger>,
        </vx300s_right/joints/shoulder>,
        </vx300s_right/joints/waist>,
        </vx300s_right/joints/wrist_angle>,
        </vx300s_right/joints/wrist_rotate>,
        </vx300s_right/root_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </vx300s_right/follower_right_base_link>,
        </vx300s_right/follower_right_ee_arm_link>,
        </vx300s_right/follower_right_ee_gripper_link>,
        </vx300s_right/follower_right_fingers_link>,
        </vx300s_right/follower_right_gripper_bar_link>,
        </vx300s_right/follower_right_gripper_link>,
        </vx300s_right/follower_right_gripper_prop_link>,
        </vx300s_right/follower_right_left_finger_link>,
        </vx300s_right/follower_right_lower_forearm_link>,
        </vx300s_right/follower_right_right_finger_link>,
        </vx300s_right/follower_right_shoulder_link>,
        </vx300s_right/follower_right_upper_arm_link>,
        </vx300s_right/follower_right_upper_forearm_link>,
        </vx300s_right/follower_right_wrist_link>,
    ]
    token isaac:robotType
    string isaac:source
    string isaac:version

    over "follower_right_base_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "follower_right_shoulder_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "waist" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "shoulder" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "elbow" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "forearm_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "wrist_angle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
