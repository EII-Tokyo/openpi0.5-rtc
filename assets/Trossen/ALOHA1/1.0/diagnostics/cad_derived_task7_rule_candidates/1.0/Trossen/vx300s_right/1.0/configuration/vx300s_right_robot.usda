    over "follower_right_gripper_bar_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "follower_right_fingers_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "follower_right_ee_gripper_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "follower_right_left_finger_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
