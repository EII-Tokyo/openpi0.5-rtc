#usda 1.0

over "World"
{
    over "follower_left"
    {
        over "vx300s_left"
        {
            over "joints"
            {
            over "waist" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "shoulder" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = -55.003948
                float drive:angular:physics:targetPosition = -55.003948
            }

            over "elbow" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 66.463104
                float drive:angular:physics:targetPosition = 66.463104
            }

            over "forearm_roll" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "wrist_angle" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = -17.188734
                float drive:angular:physics:targetPosition = -17.188734
            }

            over "wrist_rotate" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "gripper" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "left_finger" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float state:linear:physics:position = 0.02239
                float drive:linear:physics:targetPosition = 0.02239
            }

            over "right_finger" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float state:linear:physics:position = -0.02239
            }
            }
        }
    }

    over "follower_right"
    {
        over "vx300s_right"
        {
            over "joints"
            {
            over "waist" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "shoulder" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = -55.003948
                float drive:angular:physics:targetPosition = -55.003948
            }

            over "elbow" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 66.463104
                float drive:angular:physics:targetPosition = 66.463104
            }

            over "forearm_roll" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "wrist_angle" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = -17.188734
                float drive:angular:physics:targetPosition = -17.188734
            }

            over "wrist_rotate" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "gripper" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float state:angular:physics:position = 0.0
                float drive:angular:physics:targetPosition = 0.0
            }

            over "left_finger" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float state:linear:physics:position = 0.02239
                float drive:linear:physics:targetPosition = 0.02239
            }

            over "right_finger" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float state:linear:physics:position = -0.02239
            }
            }
        }
    }
}
