#usda 1.0

over "vx300s_left"
{
    over "follower_left_ee_arm_link" (
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
    }

    over "follower_left_fingers_link" (
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
    }

    over "follower_left_ee_gripper_link" (
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
    }

    over "joints"
    {
        over "ee_arm"
        {
            bool physics:jointEnabled = 0
        }

        over "ee_bar"
        {
            bool physics:jointEnabled = 0
        }

        over "ee_gripper"
        {
            bool physics:jointEnabled = 0
        }

        over "gripper"
        {
            rel physics:body0 = </vx300s_left/follower_left_gripper_link>
            point3f physics:localPos0 = (0.048499983, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }

        over "gripper_bar"
        {
            rel physics:body0 = </vx300s_left/follower_left_gripper_link>
            point3f physics:localPos0 = (0.042824984, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }

        over "left_finger"
        {
            rel physics:body0 = </vx300s_left/follower_left_gripper_bar_link>
            point3f physics:localPos0 = (0.025875002, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }

        over "right_finger"
        {
            rel physics:body0 = </vx300s_left/follower_left_gripper_bar_link>
            point3f physics:localPos0 = (0.025875002, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }
    }
}

