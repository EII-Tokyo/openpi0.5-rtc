#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        float physics:gravityMagnitude = 0
        uint physxScene:timeStepsPerSecond = 240
        uniform token physxScene:broadphaseType = "SAP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
    }

    over "follower_left"
    {
        over "vx300s_left"
        {
            over "follower_left_base_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_shoulder_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_upper_arm_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_upper_forearm_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_lower_forearm_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_wrist_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_gripper_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_ee_arm_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_gripper_prop_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_gripper_bar_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_fingers_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_ee_gripper_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_left_finger_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }

            over "follower_left_right_finger_link" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                bool physxRigidBody:enableCCD = 1
            }
        }
    }
}
