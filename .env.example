# Robot actor test defaults for 192.168.1.103.
#
# Copy these values into .env on the target machine when running the RLT
# warmup runtime. The checkpoint directory contains both actor.msgpack and
# critic.msgpack.
RLT_ACTOR_CHECKPOINT_PATH=/app/local_rlt_runs/rlt_unified_468_td3_burn5000_actor10000/inference_actor/00012000
RLT_ACTOR_POLL_INTERVAL=0.0
RLT_DEFAULT_CRITIC_GATE_ENABLED=1

