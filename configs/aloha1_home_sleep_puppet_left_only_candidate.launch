<!--
  DIAGNOSTIC_ONLY_NOT_EXECUTED.
  This file is inert until explicitly passed to roslaunch. Starting it touches
  real follower-left hardware and requires a separate user authorization.
  Camera capture is intentionally isolated from the robot driver.
-->
<launch>
  <arg name="puppet_modes_left"
       default="$(find aloha)/config/puppet_modes_left.yaml"/>

  <include file="$(find interbotix_xsarm_control)/launch/xsarm_control.launch">
    <arg name="robot_model" value="vx300s"/>
    <arg name="robot_name" value="puppet_left"/>
    <arg name="base_link_frame" value="base_link"/>
    <arg name="use_world_frame" value="false"/>
    <arg name="use_rviz" value="false"/>
    <arg name="mode_configs" value="$(arg puppet_modes_left)"/>
    <arg name="load_configs" value="false"/>
    <arg name="use_sim" value="false"/>
  </include>
</launch>
