#usda 1.0
(
    defaultPrim = "aloha"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "aloha" (
    customData = {
        string aloha1_rebuild_stage = "A4_camera_marker_visual"
        bool camera_calibration_ready = 0
        bool camera_marker_positions_are_extrinsics = 0
        string camera_markers_source = "TUNED:manual_visual_layout_only"
        bool camera_render_ready = 0
        string camera_semantic_source = "CANONICAL_ALOHA_OPENPI_NAMES"
        bool openpi_observation_ready = 0
        bool render_products_created = 0
        bool rl_ready = 0
        bool rlt_replay_ready = 0
