#usda 1.0
(
    defaultPrim = "aloha"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "aloha" (
    customData = {
        string aloha1_rebuild_stage = "A3_camera_semantic_skeleton"
        bool camera_calibration_ready = 0
        string camera_semantic_source = "CANONICAL_ALOHA_OPENPI_NAMES"
        bool render_products_created = 0
        bool training_eligible = 0
    }
)
{
    def Scope "Looks"
    {
    }

    def Scope "joints"
    {
    }

    def Xform "table_link"
    {
        def Scope "visuals"
        {
            def Cube "tabletop_reference_proxy"
            {
                color3f[] primvars:displayColor = [(0.72, 0.66, 0.54)]
                double size = 1
                float3 xformOp:scale = (1.2192, 0.749, 0.02)
                double3 xformOp:translate = (0, 0, -0.01)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def Xform "support_frame"
    {
        def Scope "visuals"
        {
            def Xform "outer_footprint"
            {
                def Cube "front_outer_edge"
                {
                    color3f[] primvars:displayColor = [(0.05, 0.85, 0.2)]
                    double size = 1
                    float3 xformOp:scale = (1.22, 0.01, 0.01)
                    double3 xformOp:translate = (0, -0.3075, 0.005)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "back_outer_edge"
                {
                    color3f[] primvars:displayColor = [(0.05, 0.85, 0.2)]
                    double size = 1
                    float3 xformOp:scale = (1.22, 0.01, 0.01)
                    double3 xformOp:translate = (0, 0.3075, 0.005)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "left_outer_edge"
                {
                    color3f[] primvars:displayColor = [(0.05, 0.85, 0.2)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.625, 0.01)
                    double3 xformOp:translate = (-0.605, 0, 0.005)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "right_outer_edge"
                {
                    color3f[] primvars:displayColor = [(0.05, 0.85, 0.2)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.625, 0.01)
                    double3 xformOp:translate = (0.605, 0, 0.005)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
        }
    }

    def Xform "cam_high_link"
    {
        def Xform "cam_high_color_frame"
        {
            def Camera "cam_high" (
                customData = {
                    string mount_visual_note = "D405/mount visual meshes must remain separate from this sensor prim."
                    string sensor_semantic_note = "UsdGeom.Camera exists; intrinsics and extrinsics are not calibrated."
                }
            )
            {
                custom string aloha:calibrationStatus = "MISSING"
                custom string aloha:extrinsicsStatus = "MISSING"
                custom string aloha:intrinsicsStatus = "MISSING"
                custom bool aloha:openpiCaptureEligible = 0
                custom string aloha:openpiObsKey = "cam_high"
                custom bool aloha:renderEligible = 0
                custom bool aloha:rosBridgeEligible = 0
                custom string aloha:semanticName = "cam_high"
                custom string aloha:semanticRole = "fixed_high_third_person"
                custom string aloha:sourceType = "MISSING"
                custom string aloha:stageRole = "A3_semantic_sensor_placeholder"
                custom bool aloha:trainingEligible = 0
            }
        }
    }

    def Xform "cam_low_link"
    {
        def Xform "cam_low_color_frame"
        {
            def Camera "cam_low" (
