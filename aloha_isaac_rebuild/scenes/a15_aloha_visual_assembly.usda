def Scope "visuals"
{
    custom string aloha:stageRole = "stationary_ai_style_visual_resource_library"
    token visibility = "invisible"

    def Xform "floor_reference_link" (
        prepend references = @../../local_eval_assets/aloha_isaac_menagerie_deep_black_real_start_pose/aloha2_menagerie_scene_deep_black_real_start_pose.usd@</scene/worldBody/floor/visuals>
    )
    {
        custom string aloha:componentRole = "floor_reference"
        custom bool aloha:physicsApisStripped = 1
